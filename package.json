{
  "name": "@justlend/justlend-cli",
  "version": "1.0.0",
  "description": "CLI for JustLend DAO on TRON — V1 + V2 (Moolah) lending, sTRX/stUSDT staking, energy rental, governance",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "justlend": "dist/bin/cli.js"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "justlend-cli",
    "justlend",
    "tron",
    "defi",
    "lending",
    "cli",
    "staking",
    "trx",
    "trc20"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justlend/justlend-cli.git"
  },
  "bugs": {
    "url": "https://github.com/justlend/justlend-cli/issues"
  },
  "homepage": "https://github.com/justlend/justlend-cli#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx bin/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "test:smoke:nile": "bash scripts/nile-dry-run-smoke.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "chalk": "4.1.2",
    "cli-table3": "0.6.5",
    "commander": "12.1.0",
    "ora": "5.4.1",
    "tronlink-signer": "0.1.4",
    "tronweb": "6.2.2"
  },
  "overrides": {
    "axios": "1.18.0",
    "ws": "8.21.0",
    "qs": "6.15.2",
    "form-data": "4.0.6",
    "esbuild": "0.28.1",
    "express@4.22.1": {
      "body-parser": "1.20.6"
    },
    "express@5.2.1": {
      "body-parser": "2.3.0"
    }
  },
  "devDependencies": {
    "@types/node": "20.0.0",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.60.3"
  }
}
